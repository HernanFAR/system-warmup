<Application x:Class="SystemWarmup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SystemWarmup"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <local:BooleanInverter x:Key="InvertBoolean"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#0B1020"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#151E30"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="#1D2940"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2C3951"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#56E4BC"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EDF4FF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A6B5CB"/>
    <SolidColorBrush x:Key="GridHeaderBrush" Color="#263650"/>
    <SolidColorBrush x:Key="GridHeaderTextBrush" Color="#D4E1F3"/>
    <SolidColorBrush x:Key="LogBrush" Color="#0C1526"/>
    <SolidColorBrush x:Key="BadgeBrush" Color="#1B3B37"/>
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#78E8C2"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#081B17"/>
    <SolidColorBrush x:Key="InputBrush" Color="#25334D"/>
    <SolidColorBrush x:Key="InputTextBrush" Color="#EDF4FF"/>
    <SolidColorBrush x:Key="FooterBrush" Color="#70849F"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style TargetType="Window">
      <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Panel2Brush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Padding" Value="13,9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,9,0"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.82"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Panel2Brush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <!-- The native Windows theme draws closed ComboBox surfaces and selected items with fixed light colors.
         Use application-owned templates so the selector and its popup follow both palettes. -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Panel2Brush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Panel2Brush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="SelectorBorder" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="5"/>
              <ContentPresenter Margin="11,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                IsHitTestVisible="False" RecognizesAccessKey="True"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
              <ToggleButton x:Name="DropDownToggle" Background="Transparent" BorderThickness="0"
                            Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                      <TextBlock Text="⌄" FontSize="16" FontWeight="SemiBold"
                                 Foreground="{DynamicResource InputTextBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,3"/>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                     PlacementTarget="{Binding ElementName=SelectorBorder}">
                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" MinWidth="{Binding ActualWidth, ElementName=SelectorBorder}"
                        MaxHeight="320">
                  <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="SelectorBorder" Property="Opacity" Value="0.55"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SelectorBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="RowBackground" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource Panel2Brush}"/>
      <Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="RowHeight" Value="39"/>
      <Setter Property="ColumnHeaderHeight" Value="38"/>
      <Setter Property="SelectionMode" Value="Single"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource GridHeaderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource GridHeaderTextBrush}"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,0"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
  </Application.Resources>
</Application>