<Application x:Class="SystemWarmup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SystemWarmup"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <local:BooleanInverter x:Key="InvertBoolean"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#0B1020"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#151E30"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="#1D2940"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2C3951"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#56E4BC"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EDF4FF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A6B5CB"/>
    <SolidColorBrush x:Key="GridHeaderBrush" Color="#263650"/>
    <SolidColorBrush x:Key="GridHeaderTextBrush" Color="#D4E1F3"/>
    <SolidColorBrush x:Key="LogBrush" Color="#0C1526"/>
    <SolidColorBrush x:Key="BadgeBrush" Color="#1B3B37"/>
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#78E8C2"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#081B17"/>
    <SolidColorBrush x:Key="InputBrush" Color="#EAF3FF"/>
    <SolidColorBrush x:Key="InputTextBrush" Color="#172239"/>
    <SolidColorBrush x:Key="FooterBrush" Color="#70849F"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style TargetType="Window">
      <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Panel2Brush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Padding" Value="13,9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,9,0"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.82"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Panel2Brush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,0,0,0"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="RowBackground" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource Panel2Brush}"/>
      <Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="RowHeight" Value="39"/>
      <Setter Property="ColumnHeaderHeight" Value="38"/>
      <Setter Property="SelectionMode" Value="Single"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource GridHeaderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource GridHeaderTextBrush}"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,0"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
  </Application.Resources>
</Application>